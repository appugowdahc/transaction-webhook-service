# Postgres connection string. Neon/Supabase/Render all hand you one of these.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transactions

# Simulated external-call time. Spec says 30s.
PROCESSING_DELAY_SECONDS=30

# Max transactions being processed at once per instance.
WORKER_CONCURRENCY=200

# How often the worker looks for new rows.
WORKER_POLL_INTERVAL_SECONDS=1

# A row is marked FAILED after this many claim attempts.
MAX_ATTEMPTS=5

LOG_LEVEL=INFO
